# ─── App ───────────────────────────────────────────────
NODE_ENV=development
APP_NAME=RAG Platform

# ─── Frontend ──────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# WebSocket URL is derived from API URL (http→ws). Override if needed:
# NEXT_PUBLIC_WS_URL=ws://localhost:8000/api/v1/ws/session
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-to-a-long-random-string

# ─── Backend ───────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
ENV=development
SECRET_KEY=change-me-backend-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_EXPIRE_MINUTES=60
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15
FRONTEND_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000

# ─── Email (SMTP) — leave SMTP_HOST empty to log emails in console ─
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@rag-platform.local
SMTP_USE_TLS=true

# ─── OAuth Providers ───────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# ─── PostgreSQL (required) ─────────────────────────────
# Option A: Local PostgreSQL install (see docs/setup/WITHOUT_DOCKER.md)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=rag_user
POSTGRES_PASSWORD=rag_password
POSTGRES_DB=rag_platform
DATABASE_URL=postgresql+asyncpg://rag_user:rag_password@localhost:5432/rag_platform

# Option B: Cloud PostgreSQL (Neon / Supabase) — no local install needed
# DATABASE_URL=postgresql+asyncpg://user:pass@your-host.neon.tech/rag_platform?ssl=require

# ─── Redis (optional — not needed for auth) ────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ─── Qdrant (Vector DB) ────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=

# ─── MinIO / S3 ────────────────────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=rag-documents
S3_REGION=us-east-1

# ─── LLM Providers ─────────────────────────────────────
OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=

# ─── Embeddings ────────────────────────────────────────
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
